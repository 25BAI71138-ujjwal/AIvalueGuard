# Environment Configuration
ENVIRONMENT=development
DEMO_MODE=true

# Database (SQLite by default for zero-setup local dev; PostgreSQL supported)
DATABASE_URL=sqlite+aiosqlite:///./aivalueguard.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aivalueguard

# Redis Cache (Optional, in-memory LRU fallback active when unset)
# REDIS_URL=redis://localhost:6379/0

# Provider API Keys (Leave blank to use Demo Mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Gateway Invariants
DEFAULT_BASELINE_MODEL=gpt-4o
DEFAULT_WORKSPACE_ID=ws_default
EXACT_CACHE_TTL_SECONDS=86400
